{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": false
  },
  "ignorePatterns": [
    "packages/*/lib/**",
    "**/node_modules/**",
    "vendor/**"
  ],
  "rules": {
    "no-shadow": "error",
    "eqeqeq": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    // React Compiler compiler-optimization hints that conflict with deliberate host-ref / session-reset patterns:
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/no-children-prop": "off",
    // Defensive Set snapshot `[...listeners]` during notification iteration in store.ts:
    "unicorn/no-useless-spread": "off"
  }
}
