# ── 依赖与工具产物 ──
node_modules/
.pnpm-store/
*.log

# ── 机密（防御纵深：宁可重复，不可漏——任何位置的凭据/环境文件都不进库）──
# dev/harness-home/.credentials.yaml 已被下段覆盖；这里兜住"万一落到别处"的情况
.env
.env.*
!.env.example
**/.credentials.yaml
*.pem
*.key

# ── OS / 编辑器杂物 ──
.DS_Store
.vscode/
.idea/

# ── 开发 DSH_HOME 的运行残留（目录本体进库，内容不进）──
dev/harness-home/*
!dev/harness-home/.gitkeep

# ── 研究运行时状态：runs/ 内容是 runtime truth，不进版本控制；
#    templates/ 与研究手册（AGENTS.md）是资产，进库。──
research-workspace/runs/*
!research-workspace/runs/.gitkeep

# ── 排练/冒烟残留 ──
dev/smoke-workspace/*
!dev/smoke-workspace/.gitkeep

# ── 运行时临时区（codex harness 教训：临时区随 run 走，不是版本控制对象）──
_tmp/
_cache/
