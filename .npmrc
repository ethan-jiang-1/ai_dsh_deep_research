# 工具态纪律（company §11 沿袭）：pnpm store 钉进本仓 gitignored 运行区，不落全局
store-dir=dev/smoke-workspace/pnpm-store

# vendor/dsh 作为 submodule，其根 postinstall（lefthook）与 submodule git config 天然冲突
# （core.worktree 在 common config，lefthook 想开 worktreeConfig 被拒）——关掉 run 前的
# deps 预检（它会自动重跑 install 然后死在同一处）；依赖状态由根 install 保证。
verify-deps-before-run=false
