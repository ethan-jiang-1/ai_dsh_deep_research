{
  "name": "ai-dsh-deep-research",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "DSH Deep Research 插件项目：多角色研究团队 preset pack（Lead/Scout/Analyst/Critic）+ Agent Team 协作。方法论内核源自 codex Deep Research harness 考古。",
  "license": "MIT",
  "author": "The ai_dsh_deep_research authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan-jiang-1/ai_dsh_deep_research.git"
  },
  "homepage": "https://github.com/ethan-jiang-1/ai_dsh_deep_research#readme",
  "bugs": {
    "url": "https://github.com/ethan-jiang-1/ai_dsh_deep_research/issues"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "verify": "node checks/verify/verify.mjs",
    "test": "pnpm test:spec && pnpm test:checks",
    "test:vendor": "TSX_TSCONFIG_PATH=\"$(pwd -P)/tsconfig.json\" node --import tsx/esm --test --test-reporter=spec 'tests/vendor/*.vendor.spec.mjs'",
    "build": "pnpm --filter dsh-deep-research-pack build",
    "lint": "oxlint packages/deep-research-pack/src",
    "typecheck": "tsc -b packages/deep-research-pack --pretty false && tsc -p tsconfig.scripts.json --pretty false",
    "release:check": "node checks/release/release-check.mjs",
    "dsh": "node --import tsx/esm vendor/dsh/apps/cli/src/bin.ts",
    "test:coverage": "TSX_TSCONFIG_PATH=\"$(pwd -P)/packages/deep-research-pack/tsconfig.client.json\" node --import tsx/esm --import ./tests/cockpit/css-module-helpers.mjs --test --experimental-test-coverage 'tests/run/**/*.spec.mjs' 'tests/cockpit/**/*.spec.mjs' 'tests/pack/**/*.spec.mjs' 'tests/contracts/**/*.spec.mjs'",
    "test:spec": "TSX_TSCONFIG_PATH=\"$(pwd -P)/packages/deep-research-pack/tsconfig.client.json\" node --import tsx/esm --import ./tests/cockpit/css-module-helpers.mjs --test --test-reporter=spec 'tests/run/**/*.spec.mjs' 'tests/cockpit/**/*.spec.mjs' 'tests/pack/**/*.spec.mjs' 'tests/contracts/**/*.spec.mjs'",
    "test:checks": "TSX_TSCONFIG_PATH=\"$(pwd -P)/packages/deep-research-pack/tsconfig.client.json\" node --import tsx/esm --test --test-reporter=spec 'tests/checks/*/*.test.mjs'",
    "test:e2e": "node checks/test/run-lane.mjs e2e",
    "test:entry": "node checks/test/run-lane.mjs entry",
    "docs:gen": "node tools/record/render-docs-reference.mjs",
    "docs:check": "node tools/record/render-docs-reference.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-instructions": "workspace:*",
    "@deepseek-ai/dsh-agent-preset": "workspace:*",
    "@deepseek-ai/dsh-agent-preset-registry": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "workspace:*",
    "@deepseek-ai/dsh-loader-smoke": "workspace:*",
    "@deepseek-ai/dsh-persona": "workspace:*",
    "@deepseek-ai/dsh-plugin-market-index": "workspace:*",
    "@deepseek-ai/dsh-session-query-sqlite": "workspace:*",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:*",
    "@deepseek-ai/dsh-token-meter": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-fs": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-goal": "workspace:*",
    "@deepseek-ai/dsh-tool-present": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@deepseek-ai/dsh-tool-skill": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/dsh-tool-todo": "workspace:*",
    "@deepseek-ai/dsh-tool-web": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "dsh-deep-research-pack": "workspace:*",
    "fast-check": "^4.11.0",
    "js-yaml": "4.3.2",
    "jsdom": "^31.0.1",
    "oxlint": "1.81.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4",
    "typescript": "^6.0.3"
  }
}
