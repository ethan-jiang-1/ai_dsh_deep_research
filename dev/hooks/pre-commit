#!/usr/bin/env bash
# dev/hooks/pre-commit — 提交门禁：verify + keyless tests 红灯即拦 commit（fail-loud）。
# 依据：guides/60 §4（收尾必跑）+ agent-friendly-polish Note 教训 4（红 commit 509a04b
# 溜进历史的实证——提交链必须挂在验证退出码上，不能靠 agent 记得）。
# 启用：source dev/env.sh（幂等 git config core.hooksPath dev/hooks）或手动同款命令。
# 应急绕过：git commit --no-verify（须在 commit message 说明跳过的面与理由）。
# 测试输出重定向进 dev/smoke-workspace/（gitignored 工具态区——纪律：工具状态不落 /tmp）。
set -u
cd "$(git rev-parse --show-toplevel)" || { echo "pre-commit: 不在 git 仓库内？" >&2; exit 1; }
node scripts/verify.mjs || { echo; echo "pre-commit: verify 红灯——commit 已拦（修完再提；应急 --no-verify 须在 message 说明）" >&2; exit 1; }
out="dev/smoke-workspace/pre-commit-test.out"
node --test tests/*.test.mjs >"$out" 2>&1 || { tail -25 "$out" >&2; echo "pre-commit: tests 红灯——commit 已拦（详情如上；应急 --no-verify 须在 message 说明）" >&2; exit 1; }
echo "pre-commit: verify + tests 绿"
