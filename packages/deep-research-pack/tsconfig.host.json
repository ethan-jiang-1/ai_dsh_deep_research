// Host 编译面：src/index.ts（观察面宿主位空壳，D18）+ src/fetch-fallback/（抓取回退 provider，D31）。
// 与 client 面分叶的原因：两面各自拉不同的 Context 类型增强，单程序两者不可兼得
// （company 2026-09-25 实证；vendor「双编译面」形态，范本 = experimental/inspector）。
{
  "extends": "../../vendor/dsh/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.host.tsbuildinfo",
    // 清掉 vendor base 的 paths（把 vendor src 拉进本程序会带出 vendored 包内部类型错误）；
    // 改用 node_modules 里已构建的 lib/types 声明。
    "paths": {}
  },
  "include": ["src/index.ts", "src/fetch-fallback", "src/method-library-tool.ts", "src/lib/library-fold.ts", "src/lib/text-fold.ts", "src/lib/method-library-write.ts"]
}
