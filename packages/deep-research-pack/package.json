{
  "name": "dsh-deep-research-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deep Research multi-role plugin pack: 4 research role presets (Lead / Scout / Analyst / Critic) + host bundle rows (preset roster, deliverables, team UI). Team mechanics come from the dsh-experimental-agent-team-profile layer installed per profile. Methodology kernel from codex Deep Research harness. Design docs: docs/00-index.md",
  "files": [
    "presets/**",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-persona": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-skill": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-todo": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-present": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-web": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "^0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": [
        "dsh-v0.1.7-rc.2"
      ]
    }
  }
}
