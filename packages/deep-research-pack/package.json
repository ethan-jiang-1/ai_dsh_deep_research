{
  "name": "dsh-deep-research-pack",
  "version": "0.3.4",
  "private": false,
  "type": "module",
  "description": "Deep Research multi-role plugin pack: 4 research role presets (Lead / Scout / Analyst / Critic) + 1 method-editor preset + 2 non-role worker profiles (Research Worker / Research Wave Executor) + host bundle rows (preset roster, deliverables, team UI). Team mechanics come from the dsh-experimental-agent-team-profile layer installed per profile. Methodology kernel from codex Deep Research harness. Repository docs: https://github.com/ethan-jiang-1/ai_dsh_deep_research",
  "license": "MIT",
  "author": "The ai_dsh_deep_research authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan-jiang-1/ai_dsh_deep_research.git",
    "directory": "packages/deep-research-pack"
  },
  "homepage": "https://github.com/ethan-jiang-1/ai_dsh_deep_research/tree/master/packages/deep-research-pack#readme",
  "bugs": {
    "url": "https://github.com/ethan-jiang-1/ai_dsh_deep_research/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deep-research",
    "agent-team",
    "plugin",
    "research"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <=0.2.1-rc.5"
  },
  "icon": "./icon.svg",
  "files": [
    "LICENSE",
    "presets/**",
    "workers/**",
    "content/**",
    "cordis.patch.yml",
    "lib/**",
    "!lib/**/*.js.map",
    "!lib/*.tsbuildinfo",
    "!lib/types/**/*.js",
    "!lib/types/**/*.map",
    "locale/**",
    "locale-content/**",
    "locale-startup/**",
    "locale-fetch-fallback/**",
    "locale-method-library/**",
    "icon.svg",
    "scripts/**"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent-instructions": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-time-context": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-goal": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-present": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-session-query": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-todo": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-web": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-workflow": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow-ptc": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-web-deepseek-api": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/analyst.patch.yml",
        "./presets/critic.patch.yml",
        "./presets/lead.patch.yml",
        "./presets/scout.patch.yml",
        "./presets/method-editor.patch.yml",
        "./workers/research-worker.patch.yml",
        "./workers/research-wave.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./fetch-fallback": {
      "types": "./lib/types/fetch-fallback/index.d.ts",
      "default": "./lib/fetch-fallback.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./content/locale/*.json": "./locale-content/*.json",
    "./content/icon": "./icon.svg",
    "./startup/locale/*.json": "./locale-startup/*.json",
    "./startup/icon": "./icon.svg",
    "./fetch-fallback/locale/*.json": "./locale-fetch-fallback/*.json",
    "./fetch-fallback/icon": "./icon.svg",
    "./method-library-tool": {
      "types": "./lib/types/method-library-tool.d.ts",
      "default": "./lib/method-library-tool.js"
    },
    "./method-library-tool/icon": "./icon.svg",
    "./method-library-tool/locale/*.json": "./locale-method-library/*.json",
    "./content": {
      "types": "./lib/types/content/index.d.ts",
      "default": "./lib/content.js"
    },
    "./startup": {
      "types": "./lib/types/startup/index.d.ts",
      "default": "./lib/startup.js"
    },
    "./defaults": {
      "types": "./lib/types/defaults/index.d.ts",
      "default": "./lib/defaults.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\" && tsc -b . && tsdown",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "zod": "^4.4.3"
  },
  "bin": {
    "dsh-deep-research-doctor": "./scripts/doctor.mjs"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
