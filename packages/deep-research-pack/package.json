{
  "name": "dsh-deep-research-pack",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Deep Research multi-role plugin pack: 4 research role presets (Lead / Scout / Analyst / Critic) + host bundle rows (preset roster, deliverables, team UI). Team mechanics come from the dsh-experimental-agent-team-profile layer installed per profile. Methodology kernel from codex Deep Research harness. Repository docs: https://github.com/ethan-jiang-1/ai_dsh_deep_research",
  "license": "MIT",
  "author": "The ai_dsh_deep_research authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan-jiang-1/ai_dsh_deep_research.git",
    "directory": "packages/deep-research-pack"
  },
  "homepage": "https://github.com/ethan-jiang-1/ai_dsh_deep_research/tree/master/packages/deep-research-pack#readme",
  "bugs": {
    "url": "https://github.com/ethan-jiang-1/ai_dsh_deep_research/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deep-research",
    "agent-team",
    "plugin",
    "research"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "LICENSE",
    "presets/**",
    "cordis.patch.yml",
    "lib/**",
    "!lib/*.tsbuildinfo",
    "!lib/types/**/*.js",
    "!lib/types/**/*.map",
    "workspace/**",
    "scripts/**"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-instructions": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-persona": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-goal": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-present": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-session-query": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-todo": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-web": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/analyst.patch.yml",
        "./presets/critic.patch.yml",
        "./presets/lead.patch.yml",
        "./presets/scout.patch.yml"
      ]
    },
    "compatibility": {
      "dshReleases": [
        "dsh-v0.2.1-rc.2"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b . && tsdown",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:*",
    "@deepseek-ai/dsh-experimental-agent-team": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*"
  },
  "bin": {
    "dsh-deep-research-preflight": "./scripts/preflight.mjs",
    "dsh-deep-research-scaffold": "./scripts/scaffold.mjs"
  }
}
