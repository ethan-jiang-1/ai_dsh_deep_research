// Client 编译面：编 src/client/** + src/lib/**（共享折算；composite 工程要求 import 的文件显式列进 include——TS6307 实测）
// 与 host 面分叶的原因见 tsconfig.host.json 头注（Context 类型增强冲突）。
{
  "extends": "../../vendor/dsh/tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo",
    "paths": {}
  },
  "include": ["src/client", "src/lib"]
}
